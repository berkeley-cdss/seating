{% extends 'base.html.j2' %}
{% import 'macros.html.j2' as macros with context %}

{% block body %}
<div class="mdl-grid assign-bar">
{% call macros.form(form) %}
  <div class="mdl-cell mdl-cell--12-col delist">
    <div class="checkbox" id="ignore_restrictions">
      {{ form.ignore_restrictions }}
      <label class="" for="ignore_restrictions">Ignore Restrictions?</label>
    </div>
    <div class="mdl-textfield mdl-js-textfield mdl-textfield--floating-label mdl-cell--12-col">
      {{ form.seat_id(class="mdl-textfield__input", type="text", id="seat_id") }}
      <label class="mdl-textfield__label" for="seat_id">Seat ID (Leave blank for random)</label>
    </div>
  </div>
  <div id="selected-seat" class="selected-seat" aria-live="polite"></div>
  <div class="form-buttons">
      {{ form.submit(class="mdl-button mdl-js-button mdl-button--raised") }}
      {{ form.just_delete(class="mdl-button mdl-js-button mdl-button--raised") }}
  </div>
{% endcall %}
</div>
<div class="">
{% for room in exam.rooms %}
  {{ macros.room(room, highlight_seat_id=seat_id, show_attributes=True, remove_link=True) }}
  <hr style="border-top: 1px solid black;" />
{% endfor %}
</div>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        var field = document.getElementById('seat_id');
        var selectedLabel = document.getElementById('selected-seat');

        function seatName(seat) {
            if (!seat.classList.contains('seat')) {
                return 'movable seat ' + seat.id;
            }
            // fixed seats show their name on the first line of their tooltip
            var tooltip = document.querySelector('.seat-tooltip[for="' + seat.id + '"]');
            return tooltip ? tooltip.firstChild.textContent.trim() : seat.id;
        }

        function selectSeat(seatId) {
            document.querySelectorAll('.s.selected').forEach(function(seat) {
                seat.classList.remove('selected');
            });
            var seat = seatId ? document.getElementById(seatId) : null;
            if (seat && seat.classList.contains('s')) {
                seat.classList.add('selected');
                selectedLabel.textContent = 'Selected seat: ' + seatName(seat);
            } else {
                selectedLabel.textContent = '';
            }
        }

        document.querySelectorAll('.s').forEach(function(seat) {
            seat.addEventListener('click', function() {
                field.value = this.id;
                // MDL only floats the label on user input, so mark the field dirty ourselves
                field.parentNode.classList.add('is-dirty');
                selectSeat(this.id);
            });
        });
        field.addEventListener('input', function() {
            selectSeat(field.value.trim());
        });
    });
</script>
{% endblock %}